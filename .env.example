# PRDForge Environment Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# Server Configuration
# =============================================================================

# Port for the PRDForge web server
PRDFORGE_PORT=8000

# Port for development server (when using dev profile)
PRDFORGE_DEV_PORT=8001

# Log level: DEBUG, INFO, WARNING, ERROR
PRDFORGE_LOG_LEVEL=INFO

# Enable debug mode (true/false)
PRDFORGE_DEBUG=false

# =============================================================================
# Project Configuration
# =============================================================================

# Directory containing your projects (mounted into container)
PRDFORGE_PROJECTS_DIR=./projects

# =============================================================================
# AI Executor API Keys
# =============================================================================

# Anthropic API key for Claude (required for claude-api executor)
ANTHROPIC_API_KEY=

# OpenAI API key for Codex/GPT (optional, for codex executor)
OPENAI_API_KEY=

# Google API key for Gemini (optional, for gemini executor)
GOOGLE_API_KEY=

# =============================================================================
# Database Configuration (Advanced)
# =============================================================================

# Custom database path (default: /app/data/prdforge.db in container)
# PRDFORGE_DB_PATH=/custom/path/prdforge.db
